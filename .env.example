# ---- search -------------------------------------------------------------
# Optional. Enables true reverse-image search (Google Lens / Yandex via
# SerpAPI). Without it the pipeline falls back to hint-assisted key-free
# engines. Free tier: https://serpapi.com
SERPAPI_KEY=

# ---- blockchain ---------------------------------------------------------
# Only needed for a public testnet (--network sepolia|amoy).
# Local (ganache/anvil) and in-process (tester) chains need neither.
RPC_URL=
PRIVATE_KEY=

# Reuse an already-deployed registry instead of deploying a new one.
CONTRACT_ADDRESS=
